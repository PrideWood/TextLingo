# TextLingo environment variables
# Private keys must stay server-side. Do not use NEXT_PUBLIC_ for API keys.

# Lightweight access protection
TEXTLINGO_ACCESS_CODE=
TEXTLINGO_ACCESS_CODES=

# General OpenAI-compatible text analysis fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional DeepSeek text analysis fallback
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Qwen text analysis fallback.
# QWEN_API_KEY is only used for text analysis when QWEN_TEXT_MODEL is set.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=

# Optional per-feature text analysis overrides.
# If omitted, each feature falls back to DeepSeek/Qwen text/OpenAI settings above.
TITLE_API_KEY=
TITLE_BASE_URL=
TITLE_MODEL=

TRANSLATE_API_KEY=
TRANSLATE_BASE_URL=
TRANSLATE_MODEL=

KNOWLEDGE_API_KEY=
KNOWLEDGE_BASE_URL=
KNOWLEDGE_MODEL=

QUIZ_API_KEY=
QUIZ_BASE_URL=
QUIZ_MODEL=

# OCR / image recognition.
# Mainland China DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# International / Singapore DashScope: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OCR_PROVIDER=qwen-vl
OCR_API_KEY=
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_MODEL=qwen-vl-ocr-latest
QWEN_VISION_MODEL=qwen-vl-ocr-latest

# Optional placeholder TTS configuration. TTS is still a frontend/server skeleton.
TTS_API_KEY=
